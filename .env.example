# 复制为 .env 后按需填写。.env 会被 .gitignore 忽略，本模板 .env.example 可提交。
#
# 不填也能跑完整演示：未配置凭据时，工作台问答走本地直出，不调用上游模型
# （这是设计行为，不是故障）。只有需要接真实 Nexent 平台时才填下面三项。

# Nexent 平台地址。本地 docker 部署默认 5013。
NEXENT_BASE_URL=http://localhost:5013

# 发布 Agent 后生成的一次性 Access Key。服务端只存哈希、无法反查，
# 丢失只能在平台重新生成一条，所以别把它写进任何提交。
NEXENT_API_KEY=

# 要调用的 Agent 名称，与平台侧的注册名一致。
NEXENT_AGENT_NAME=urban_deduction_agent
