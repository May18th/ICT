*.py[cod]

# Local Codex handoff notes
codex/

# Unreal generated project state
visualization/unreal/*.bak-mcp
visualization/unreal/*.bak-*
visualization/unreal/Saved/
visualization/unreal/Intermediate/
visualization/unreal/DerivedDataCache/
visualization/unreal/Binaries/

# test/eval local artifacts
.pytest-report.xml
.pytest-uv.xml
pytest-of-*/
.uecheck/

# P10 渲染作业 / 快照 / 工具调用日志（本地运行时产物，可随时删）
artifacts/
.tmp/

# 手工导出与外部资料落地目录（如官方手册 PDF 及其解析副本），本质是输出物，不进仓库
out/

# 临时探针脚本与浏览器 crashpad 落盘（`git add -A` 会把它们一起带走，踩过一次）
tmp_*.py
codex-cdp-*/

# Blender 自动备份与场景目录快照
*.blend1
visualization/blender/scenes.bak-*/

# 真实模型凭据只走环境变量；本地 .env 不入库
.env
.env.*
!.env.example

# real user review records contain personal data; keep them out of git (or point URBAN_TWIN_REVIEWS elsewhere)
samples/eval/review_submissions.jsonl
samples/eval/review_gate_reviews.json

# 有条件开放数据（《数据利用承诺书》约束：原始文件与入库副本不得进入代码仓库、不得随作品包提交）
samples/scenarios/**/raw_conditional/
samples/data/raw_conditional/
*.conditional.json
*.conditional.csv

# 发布目录：含 .env 密钥与 src 副本，不进仓库
deploy-webdemo/

# RAG 索引（build 产物，60~150 MB，按需重建）
.rag_index*/

# 训练产物（模型权重不入仓）
dist/

# 本地模型/引擎缓存（HF 权重与 pyswmm 输出，可重建）
.cache/
